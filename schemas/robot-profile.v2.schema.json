{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcheng-robotics.github.io/schemas/robot-profile.v2.schema.json",
  "title": "Robot profile v2",
  "description": "Bus-agnostic robot profile for one or more kinematic chains. Joint-space limits stay in SI units; the bus fields are constrained by `kind`. Cross-field rules that JSON Schema cannot express (unique chain ids, joint.chain references, lower < upper, closed/open inside the bounds) are enforced by the runtime profile loader. v1 profiles remain valid under robot-profile.v1.schema.json and are not reinterpreted here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "robot", "profile_version", "chains", "joints", "profiles", "source_hashes"],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {
      "enum": ["bus_servo", "can_arm", "ethercat_arm"],
      "description": "bus_servo requires joints[].servo_id; can_arm and ethercat_arm require joints[].index."
    },
    "robot": {"type": "string", "minLength": 1},
    "profile_version": {"type": "string", "minLength": 1},
    "baseline_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {"type": "string"},
        "tag": {"type": "string"},
        "commit": {"type": "string"}
      }
    },
    "chains": {
      "type": "array",
      "minItems": 1,
      "description": "One entry per independently commanded kinematic chain. The leader of a master-slave pair is an input device and is not a chain here.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "base_link", "tip_link", "workspace"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "role": {"enum": ["single", "left", "right"]},
          "base_link": {"type": "string", "minLength": 1},
          "tip_link": {"type": "string", "minLength": 1},
          "moveit_group": {"type": "string", "minLength": 1},
          "workspace": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lower", "upper"],
            "properties": {
              "frame": {"type": "string", "minLength": 1, "description": "Defaults to the chain base_link."},
              "lower": {"$ref": "#/$defs/vec3"},
              "upper": {"$ref": "#/$defs/vec3"}
            }
          }
        }
      }
    },
    "joints": {
      "type": "array",
      "minItems": 1,
      "description": "Actuated arm joints. A gripper's master joint is described by the gripper object and is not listed here.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "chain", "lower_rad", "upper_rad", "max_velocity_rad_s", "max_acceleration_rad_s2"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "chain": {"type": "string", "minLength": 1},
          "type": {"enum": ["revolute", "prismatic"], "default": "revolute"},
          "index": {"type": "integer", "minimum": 1, "description": "1-based vendor joint index; can_arm and ethercat_arm only."},
          "servo_id": {"type": "integer", "minimum": 1, "description": "Bus-servo id; bus_servo only."},
          "lower_rad": {"type": "number"},
          "upper_rad": {"type": "number"},
          "max_velocity_rad_s": {"type": "number", "exclusiveMinimum": 0},
          "max_acceleration_rad_s2": {"type": "number", "exclusiveMinimum": 0},
          "direction": {"enum": [-1, 1]}
        },
        "oneOf": [
          {"required": ["servo_id"], "not": {"required": ["index"]}},
          {"required": ["index"], "not": {"required": ["servo_id"]}}
        ]
      }
    },
    "gripper": {
      "description": "Optional. Bounds and the closed/open positions are expressed in the declared unit; `position_rad` in MotionCommand v1 carries this value until the v0.3.0 message change.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "servo_id", "unit", "lower", "upper", "closed", "open", "max_velocity", "measured_open_pulses", "measured_closed_pulses"],
          "properties": {
            "type": {"const": "bus_servo"},
            "servo_id": {"type": "integer", "minimum": 1},
            "unit": {"const": "rad"},
            "lower": {"type": "number"},
            "upper": {"type": "number"},
            "closed": {"type": "number"},
            "open": {"type": "number"},
            "max_velocity": {"type": "number", "exclusiveMinimum": 0},
            "measured_open_pulses": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
            "measured_closed_pulses": {"type": "array", "minItems": 1, "items": {"type": "integer"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "master_joint", "unit", "lower", "upper", "closed", "open", "max_velocity"],
          "properties": {
            "type": {"const": "parallel_prismatic"},
            "master_joint": {"type": "string", "minLength": 1},
            "unit": {"const": "m"},
            "lower": {"type": "number", "minimum": 0},
            "upper": {"type": "number", "exclusiveMinimum": 0},
            "closed": {"type": "number"},
            "open": {"type": "number"},
            "max_velocity": {"type": "number", "exclusiveMinimum": 0},
            "mimic_joints": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "multiplier", "offset"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "multiplier": {"type": "number"},
                  "offset": {"type": "number"}
                }
              }
            }
          }
        }
      ]
    },
    "table_plane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normal", "offset", "clearance_m"],
      "properties": {
        "normal": {"$ref": "#/$defs/vec3"},
        "offset": {"type": "number"},
        "clearance_m": {"type": "number", "minimum": 0}
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moveit", "step", "pose", "fast"],
      "properties": {
        "moveit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_velocity_rad_s", "max_acceleration_rad_s2"],
          "properties": {
            "max_velocity_rad_s": {"type": "number", "exclusiveMinimum": 0},
            "max_acceleration_rad_s2": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "step": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_step_rad", "min_duration_s", "max_duration_s"],
          "properties": {
            "max_step_rad": {"type": "number", "exclusiveMinimum": 0},
            "min_duration_s": {"type": "number", "exclusiveMinimum": 0},
            "max_duration_s": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "pose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_velocity_rad_s"],
          "properties": {"max_velocity_rad_s": {"type": "number", "exclusiveMinimum": 0}}
        },
        "fast": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_velocity_rad_s", "max_acceleration_rad_s2", "requires_measured_verification"],
          "properties": {
            "max_velocity_rad_s": {"type": "number", "exclusiveMinimum": 0},
            "max_acceleration_rad_s2": {"type": "number", "exclusiveMinimum": 0},
            "requires_measured_verification": {"const": true}
          }
        },
        "base": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_abs_duty_normalized", "vendor_duty_scale", "max_duration_s"],
          "properties": {
            "max_abs_duty_normalized": {"type": "number", "minimum": 0, "maximum": 1},
            "vendor_duty_scale": {"type": "number", "exclusiveMinimum": 0},
            "max_duration_s": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "gripper": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_velocity": {"type": "number", "exclusiveMinimum": 0},
            "verify_measured": {"type": "boolean"}
          }
        }
      }
    },
    "source_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    }
  },
  "allOf": [
    {
      "if": {"required": ["kind"], "properties": {"kind": {"const": "bus_servo"}}},
      "then": {"properties": {"joints": {"items": {"required": ["servo_id"]}}}},
      "else": {"properties": {"joints": {"items": {"required": ["index"]}}}}
    }
  ],
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    }
  }
}
